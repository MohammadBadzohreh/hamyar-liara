# npm run setup generates local credentials. Never commit .env.
HOST=127.0.0.1
PORT=3000
DATA_DIR=.local/data
OWNER_PASSWORD_HASH=
ENCRYPTION_KEY=
LIARA_API_TOKEN=
LIARA_TEAM_ID=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=google/gemini-2.5-flash
AI_REPAIR_MODEL=google/gemini-2.5-pro
GITHUB_TOKEN=
# owner/repository of the standalone sample repository
REPAIR_REPOSITORY=
REPAIR_WORKFLOW=acceptance.yml
DEMO_TOKEN=
# Only set these after validating actual account responses and units.
LIARA_PRICE_SCHEMA_VERIFIED=false
LIARA_BALANCE_FIELD=
LIARA_TAX_RATE=
LIARA_ENV_UPDATE_MODE=unverified
LIARA_CPU_UNIT=unknown
LIARA_MEMORY_UNIT=unknown
